# 复制到 .env 并填写;已存在的 .env 不要覆盖。
ANTCHAT_API_KEY=

# MatrixLLM 模型按需填写;单独探测 Qwen 不要求这些变量。
MATRIXLLM_API_KEY=
X_LY_TOKEN_GPT=
X_LY_TOKEN_CLAUDE=
X_LY_TOKEN_GEMINI=
OPENROUTER_API_KEY=

# --- MCP-Universe(IMAct/benchmarks/mcp_universe) ---
# MCP 网关:agent 与评分都经它访问真实服务(github / google-maps / yfinance / playwright / notion …)。
MCP_GATEWAY_ADDRESS=
MCP_GATEWAY_TOKEN=
# 远程评估:yfinance / playwright 爬取类的评估在网关那台机器上执行(本机直连 Yahoo 会被限流)。不配则在本机执行。
EVAL_REMOTE_URL=
EVAL_REMOTE_PREFIXES=yfinance.,playwright.check_
# 会创建资源的 43 个 task(repository_management 与带 Notion 的 task;--skip-side-effects 可排除)需要下面这些。
# GITHUB_PERSONAL_ACCOUNT_NAME / NOTION_ROOT_PAGE 必填;两个令牌如果只在网关那一侧,本机可留空:
# Notion 页面会经网关归档,但 GitHub 仓库无法自动删除(需手动删,或在本机填 GITHUB_PERSONAL_ACCESS_TOKEN)。
# 务必使用专用的测试账号:这些 task 会在其下创建并删除仓库 / 页面。
GITHUB_PERSONAL_ACCOUNT_NAME=
GITHUB_PERSONAL_ACCESS_TOKEN=
NOTION_API_KEY=
NOTION_ROOT_PAGE=
