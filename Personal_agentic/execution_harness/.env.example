# 本文件只是配置说明；启动脚本从进程环境读取，不自动加载 .env。
IMACT_MODEL_MODE=chat
# 或使用 TOML 配置：IMACT_CONFIG=config/model.toml
IMACT_MODEL_BASE_URL=https://your-model-gateway.example/v1
IMACT_MODEL_NAME=your-action-model
IMACT_MODEL_API_KEY=replace-me
IMACT_MODEL_TIMEOUT=90
# 单次模型决策总时限，应大于 IMACT_MODEL_TIMEOUT；不设置时自动计算。
IMACT_DECISION_TIMEOUT=120
IMACT_MODEL_MAX_OUTPUT_TOKENS=4096
# text：通过 prompt 要求 JSON；json_object：网关支持时启用。
IMACT_MODEL_RESPONSE_FORMAT=text
IMACT_DB_PATH=data/workspace.sqlite3
IMACT_CONTEXT_MAX_BYTES=240000
IMACT_MAX_DECISION_ATTEMPTS=3
# 对外提供 HTTP 服务时配置，客户端传 Authorization: Bearer ...
IMACT_SERVICE_TOKEN=
