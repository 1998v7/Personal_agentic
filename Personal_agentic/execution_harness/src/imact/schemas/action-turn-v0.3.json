{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMAct action turn v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_changes",
    "working_notes",
    "next_action"
  ],
  "properties": {
    "task_changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "meal_period": {
          "enum": [
            "breakfast",
            "lunch",
            "dinner",
            null
          ]
        },
        "destination": {
          "oneOf": [
            {
              "enum": [
                "work",
                "home",
                null
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address"
              ],
              "properties": {
                "address": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          ]
        },
        "store_choice": {
          "$ref": "#/$defs/choice"
        },
        "product_choice": {
          "$ref": "#/$defs/choice"
        },
        "preferred_delivery_minutes": {
          "$ref": "#/$defs/minutes"
        },
        "required_delivery_minutes": {
          "$ref": "#/$defs/minutes"
        },
        "taste_preferences": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "budget_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "quantity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "dietary_constraints": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object"
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "answer",
                "purchase",
                "reserve",
                "cancel",
                "modify"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expected_fields": {
              "type": "object"
            }
          }
        }
      }
    },
    "working_notes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "item_id",
              "assessment",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "candidate"
              },
              "item_id": {
                "$ref": "#/$defs/text"
              },
              "assessment": {
                "enum": [
                  "consider",
                  "defer",
                  "exclude"
                ]
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "attempt",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "failed_attempt"
              },
              "attempt": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "topic",
              "status",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "issue"
              },
              "topic": {
                "enum": [
                  "missing_product_id",
                  "unclear_authorization",
                  "unverified_order",
                  "other_requirement"
                ]
              },
              "status": {
                "enum": [
                  "open",
                  "resolved"
                ]
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "note_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "next_action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "calls"
          ],
          "properties": {
            "type": {
              "const": "call_tools"
            },
            "calls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "arguments"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text"
                  },
                  "arguments": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "question"
          ],
          "properties": {
            "type": {
              "const": "query_memory"
            },
            "question": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "mode",
            "content"
          ],
          "properties": {
            "type": {
              "const": "reply_user"
            },
            "mode": {
              "enum": [
                "ask",
                "inform"
              ]
            },
            "content": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "mode",
            "content",
            "outcome"
          ],
          "properties": {
            "type": {
              "const": "reply_user"
            },
            "mode": {
              "const": "final"
            },
            "content": {
              "$ref": "#/$defs/text"
            },
            "outcome": {
              "enum": [
                "completed",
                "partial",
                "blocked"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "choice": {
      "enum": [
        "user",
        "agent",
        null
      ]
    },
    "minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  }
}
