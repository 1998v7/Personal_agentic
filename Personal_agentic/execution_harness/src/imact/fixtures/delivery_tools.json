  {
    "type": "function",
    "function": {
      "name": "create_delivery_order",
      "description": "外卖订单创建，仅支持单个商家下单，单个商家可以下单多个商品\n\nPreconditions:\n    - 处于外卖场景，确定唯一一个店家id和一个或多个商品id，确定用户的饮食禁忌，并在订单中体现\nPostconditions:\n    - 返回订单信息，询问用户是否支付订单",
      "parameters": {
        "properties": {
          "user_id": {
            "description": "用户id",
            "title": "User Id",
            "type": "string"
          },
          "store_id": {
            "description": "商店id",
            "title": "Store Id",
            "type": "string"
          },
          "product_ids": {
            "items": {
              "type": "string"
            },
            "title": "Product Ids",
            "type": "array"
          },
          "product_cnts": {
            "items": {
              "type": "integer"
            },
            "title": "Product Cnts",
            "type": "array"
          },
          "address": {
            "description": "外卖配送目标地址",
            "title": "Address",
            "type": "string"
          },
          "dispatch_time": {
            "description": "外卖订单开始配送的时间（即骑手从商家取餐出发的时间），格式为yyyy-mm-dd HH:MM:SS",
            "title": "Dispatch Time",
            "type": "string"
          },
          "attributes": {
            "default": null,
            "description": "商品id对应商品规格属性",
            "title": "Attributes",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "default": "",
            "description": "订单备注（禁止将用户关于时间等需求直接放在备注中），如饮食禁忌信息说明",
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "store_id",
          "product_ids",
          "product_cnts",
          "address",
          "dispatch_time"
        ],
        "title": "parameters",
        "type": "object"
      }
    }
  },
